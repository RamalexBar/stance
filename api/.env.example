# Base de datos
DATABASE_URL="postgresql://stance:stance@localhost:5432/stance?schema=public"

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Firebase Admin SDK
# Se obtienen desde Firebase Console > Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada (descarga un JSON con estos tres campos).
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# Supabase Storage (Fase 2)
# Project Settings > API. La Service Role Key NUNCA se comparte con el cliente.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_VIDEOS_BUCKET=videos

# Entrenador IA (Fase 9) — https://console.anthropic.com
ANTHROPIC_API_KEY=tu-api-key-de-anthropic
ANTHROPIC_COACH_MODEL=claude-sonnet-5

# Envío de reportes por correo (Fase 10) — opcional, solo si usas "Enviar por correo"
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp
SMTP_PASS=tu-password-smtp
SMTP_FROM="Stance <no-reply@tu-dominio.com>"

# Suscripciones (Fase 12) — https://vendors.paddle.com (sandbox: sandbox-vendors.paddle.com)
# Developer Tools > Authentication para la API key; Notifications para el webhook secret.
PADDLE_API_KEY=pdl_sdbx_apikey_xxxxx
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxx
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_PREMIUM=pri_xxxxx
PADDLE_PRICE_COACH=pri_xxxxx
PADDLE_PRICE_ACADEMIA=pri_xxxxx
FRONTEND_URL=http://localhost:3000
