# Firebase (Configuración del proyecto > Apps > Config del SDK)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Backend
# En emulador Android usa http://10.0.2.2:4000 en vez de localhost
EXPO_PUBLIC_API_URL=http://localhost:4000

# Web (Fase 12) — Paddle no tiene SDK nativo para React Native, así que
# "Suscribirse" abre esta página (con Paddle.js) en el navegador del teléfono.
# En emulador Android usa http://10.0.2.2:3000 en vez de localhost.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Supabase (Fase 2) — clave ANÓNIMA, es pública por diseño
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
EXPO_PUBLIC_SUPABASE_VIDEOS_BUCKET=videos
