# Dependencies
node_modules/
**/node_modules/

# Env files with real secrets — the *.example files stay tracked
.env
.env.local
.env.development
.env.production
.env.*.local

# API (Express/Prisma)
api/dist/
api/*.tsbuildinfo

# Web (Next.js)
web/.next/
web/out/
web/*.tsbuildinfo

# Mobile (Expo/EAS)
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.jks
mobile/*.p8
mobile/*.p12
mobile/*.key
mobile/*.mobileprovision
mobile/credentials.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp
